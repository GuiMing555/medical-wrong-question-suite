<UserControl x:Class="MedicalQuestionPractice.Windows.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="980">
            <TextBlock Text="今天想练什么？" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="每答一道立即保存，随时退出都不会丢失已经提交的记录。" Foreground="{StaticResource MutedTextBrush}" FontSize="15" Margin="0,7,0,22" />

            <UniformGrid Columns="5" Margin="0,0,0,22">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="题库总数" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding TotalQuestions}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="从未练习" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding UnseenCount}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="到期复习" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding DueNormalCount}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel><TextBlock Text="当前错题" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding WrongBookCount}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel><TextBlock Text="今日已答" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding AnsweredTodayCount}" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="普通模式" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="练习从未做过或已超过复习间隔的题；题目和选项都会打乱。" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="快捷键 Ctrl+N" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="开始或继续" Command="{Binding StartNormalCommand}" Style="{StaticResource PrimaryButton}" Margin="22,0,0,0" MinWidth="138" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="错题模式" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="只练当前错题。连续答对设定次数后自动移出错题本，再次答错则重新计数。" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="快捷键 Ctrl+W" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,7,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding WrongBookButtonText}" Command="{Binding StartWrongBookCommand}" Style="{StaticResource PrimaryButton}" Margin="22,0,0,0" MinWidth="168" />
                </Grid>
            </Border>

            <Border Background="#EEF6F8" BorderBrush="#C9DFE7" BorderThickness="1" CornerRadius="10" Padding="16">
                <TextBlock Text="{Binding ActiveSessionText}" Foreground="{StaticResource PrimaryDarkBrush}" FontWeight="SemiBold" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
