<UserControl x:Class="MedicalQuestionPractice.Windows.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720">
            <TextBlock Text="练习设置" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="设置保存在共享本地数据库中，两个程序读取同一份配置。" Foreground="{StaticResource MutedTextBrush}" Margin="0,7,0,22" />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="普通题重新出现间隔（天）" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="从上次作答开始计算；设为 0 表示已经做过的题也可立即重新练习。" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,9" />
                    <TextBox Text="{Binding ReviewIntervalDays, UpdateSourceTrigger=PropertyChanged}" Width="170" HorizontalAlignment="Left" Padding="9,7" FontSize="15" />

                    <Separator Margin="0,20,0,20" />
                    <TextBlock Text="错题连续答对多少次后移出" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="中途再次答错或标记为仍需练习，连续次数会清零。" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,9" />
                    <TextBox Text="{Binding RequiredConsecutiveCorrect, UpdateSourceTrigger=PropertyChanged}" Width="170" HorizontalAlignment="Left" Padding="9,7" FontSize="15" />

                    <Separator Margin="0,20,0,20" />
                    <TextBlock Text="每轮题数" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="留空表示把当前符合条件的题全部加入本轮。" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,9" />
                    <TextBox Text="{Binding QuestionsPerSession, UpdateSourceTrigger=PropertyChanged}" Width="170" HorizontalAlignment="Left" Padding="9,7" FontSize="15" />

                    <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" Margin="0,18,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SavedMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="返回" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" MinWidth="100" />
                <Button Content="保存设置" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" MinWidth="130" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
