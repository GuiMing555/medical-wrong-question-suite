<UserControl x:Class="MedicalQuestionPractice.Windows.Views.PracticeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.InputBindings>
        <KeyBinding Key="D1" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="8" />
        <KeyBinding Key="NumPad1" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="0" />
        <KeyBinding Key="NumPad2" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="1" />
        <KeyBinding Key="NumPad3" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="2" />
        <KeyBinding Key="NumPad4" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="3" />
        <KeyBinding Key="NumPad5" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="4" />
        <KeyBinding Key="NumPad6" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="5" />
        <KeyBinding Key="NumPad7" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="6" />
        <KeyBinding Key="NumPad8" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="7" />
        <KeyBinding Key="NumPad9" Command="{Binding SelectOptionByIndexCommand}" CommandParameter="8" />
        <KeyBinding Key="U" Command="{Binding ToggleUnsureCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SubmitOrNextCommand}" />
    </UserControl.InputBindings>

    <Grid MaxWidth="980">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ModeTitle}" FontSize="23" FontWeight="Bold" />
                <Border Background="#E7F0F4" CornerRadius="5" Padding="8,3" Margin="12,1,0,0">
                    <TextBlock Text="{Binding QuestionTypeText}" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="12" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding WrongProgressText}" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{Binding Stem}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="30" />
                        <TextBlock Text="按数字键 1–9 选择选项；多选题可重复按键取消；U 标记仍需练习。" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,10,0,16" />
                        <ItemsControl ItemsSource="{Binding Options}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="OptionBorder" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,11" Margin="0,0,0,10" Background="White">
                                        <CheckBox Content="{Binding DisplayText}" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsHitTestVisible="{Binding IsSelectionEnabled}" FontSize="15" VerticalContentAlignment="Center" />
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                                            <Setter TargetName="OptionBorder" Property="Background" Value="#E6F4EC" />
                                            <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsIncorrectSelected}" Value="True">
                                            <Setter TargetName="OptionBorder" Property="Background" Value="#FBE9E7" />
                                            <Setter TargetName="OptionBorder" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox Content="这题虽然选对了，但我是蒙的或仍未掌握（仍计入错题）"
                                  IsChecked="{Binding IsUnsure}" IsEnabled="{Binding HasSubmittedAnswer, Converter={StaticResource InverseBooleanConverter}}"
                                  Margin="0,7,0,0" FontSize="14" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,16,0,0" Visibility="{Binding HasSubmittedAnswer, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding FeedbackTitle}" FontSize="19" FontWeight="Bold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsCorrect}" Value="True"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding FeedbackDetail}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding CorrectAnswerText}" FontWeight="SemiBold" Margin="0,13,0,0" />
                        <Separator Margin="0,14,0,14" />
                        <TextBlock Text="解析" FontWeight="Bold" FontSize="16" />
                        <TextBlock Text="{Binding ExplanationOptionMapping}" Foreground="{StaticResource PrimaryDarkBrush}" FontSize="12" Margin="0,7,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Explanation}" Margin="0,7,0,0" TextWrapping="Wrap" LineHeight="25" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="提交后立即写入共享数据库" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="提交答案  Enter" Command="{Binding SubmitCommand}" Style="{StaticResource PrimaryButton}" MinWidth="160" Visibility="{Binding HasSubmittedAnswer, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                <Button Content="{Binding NextButtonText}" Command="{Binding NextCommand}" Style="{StaticResource PrimaryButton}" MinWidth="180" Visibility="{Binding HasSubmittedAnswer, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
